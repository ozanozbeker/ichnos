  indexes {
    PRODUCT_ID [unique] // name match <S>_ID
  }
}

Table INV.SHIPMENTS { // read 3
  SHIPMENT_ID unknown // where 2
  WAREHOUSE_ID unknown // select 2, join 1

  indexes {
    SHIPMENT_ID [unique] // name match <S>_ID, single_row 1
  }
}

Table INV.SHIPMENT_LINES { // read 2
  SHIPMENT_ID unknown // where 1, join 1
  ORDER_ID unknown // join 2
  LINE_NO unknown // join 2
