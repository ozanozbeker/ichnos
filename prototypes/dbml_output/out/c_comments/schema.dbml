}

Table INV.STOCK_LEVELS { // read 3, write 2
  PRODUCT_ID unknown // select 1, join 3, insert 1
  WAREHOUSE_ID unknown // join 2, where 1, insert 1
  QTY_ON_HAND number // select 1, where 1, set 1, insert 1, number 1
  REORDER_POINT unknown // select 1, where 1
  UPDATED_AT datetime // set 1, insert 1, datetime 2

  indexes {
    (PRODUCT_ID, WAREHOUSE_ID) [unique] // merge 1
  }
}

Table INV.WAREHOUSES { // read 3
  ID unknown // select 1, join 3
  WAREHOUSE_CODE unknown // select 2
  NAME unknown // select 2

  indexes {
    ID [unique] // name match ID
    WAREHOUSE_CODE [unique] // name match <S>_CODE
  }
}

