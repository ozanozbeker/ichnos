Ref: SALES.ORDERS.CUSTOMER_ID >? SALES.CUSTOMERS.CUSTOMER_ID // join 6
Ref: SALES.ORDER_LINES.ORDER_ID >? SALES.ORDERS.ORDER_ID // join 7
Ref: SALES.ORDER_LINES.PRODUCT_ID >? INV.PRODUCTS.PRODUCT_ID // join 4
Ref: SALES.ORDER_PROMOTIONS.ORDER_ID >? SALES.ORDERS.ORDER_ID // join 1
Ref: SALES.ORDER_PROMOTIONS.PROMO_ID ?<>? SALES.PROMOTIONS.PROMO_ID // join 1
Ref: HR.EMPLOYEES.MANAGER_ID >? HR.EMPLOYEES.EMPLOYEE_ID // join 2
Ref: INV.STOCK_LEVELS.WAREHOUSE_ID >? INV.WAREHOUSES.ID // join 2
Ref: INV.STOCK_LEVELS.PRODUCT_ID >? INV.PRODUCTS.PRODUCT_ID // join 1
Ref: INV.SHIPMENT_LINES.(ORDER_ID, LINE_NO) ?<>? SALES.ORDER_LINES.(ORDER_ID, LINE_NO) // join 1
Ref: SALES.ORDER_LINES.PRODUCT_ID ?<>? INV.STOCK_LEVELS.PRODUCT_ID // join 1, shared reference to INV.PRODUCTS.PRODUCT_ID
Ref: ORDERS.CUSTOMER_ID >? CUSTOMERS.CUSTOMER_ID // join 1
Ref: MART.CUSTOMER_DAILY_SALES.CUSTOMER_ID >? SALES.CUSTOMERS.CUSTOMER_ID // join 1
Ref: MART.ORDER_LINE_FACTS.(CUSTOMER_ID, SALES_DATE, CURRENCY_CODE) >? MART.CUSTOMER_DAILY_SALES.(CUSTOMER_ID, SALES_DATE, CURRENCY_CODE) // join 1
