}

Table report."055_key_customers" [kind: 'report'] {
  CUSTOMER_ID unknown
  CUSTOMER_NAME unknown
  NET_AMOUNT_12M unknown
}

Table report."demo/unaliased_columns#2" [kind: 'report'] { // note: invented: unaliased and repeated output names
  ORDER_ID unknown
  "ORDER_ID (2)" unknown
  "COUNT(*)" number
  "NVL(O.SALES_REP_ID,-1)" number
}

// DBML raises on a column that depends on itself, so each self-dependency is a comment.
// self-dependency: INV.STOCK_LEVELS.QTY_ON_HAND TRANSFORMATION 1
// self-dependency: MART.CUSTOMER_SEGMENTS.SEGMENT TRANSFORMATION 1

// INV.STOCK_LEVELS
