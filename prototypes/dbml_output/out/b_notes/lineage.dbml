use * from './schema.dbml'

Table report."016_unqualified_columns_in_join" [kind: 'report', note: 'ambiguity: filter on ORDER_TOTAL and CREDIT_LIMIT: SALES.ORDERS or SALES.CUSTOMERS'] {
  ORDER_ID unknown [note: 'ambiguity: upstream SALES.ORDERS.ORDER_ID (14) or SALES.CUSTOMERS.ORDER_ID (0)']
  ORDER_DATE unknown [note: 'ambiguity: upstream SALES.ORDERS.ORDER_DATE (9) or SALES.CUSTOMERS.ORDER_DATE (0)']
  CUSTOMER_NAME unknown [note: 'ambiguity: upstream SALES.ORDERS.CUSTOMER_NAME (0) or SALES.CUSTOMERS.CUSTOMER_NAME (9)']
  CREDIT_LIMIT unknown [note: 'ambiguity: upstream SALES.ORDERS.CREDIT_LIMIT (0) or SALES.CUSTOMERS.CREDIT_LIMIT (0)']
}

Table report."038_daily_reports#1" [kind: 'report'] {
  NEW_ORDERS number
}

Table report."038_daily_reports#2" [kind: 'report'] {
  NEW_CUSTOMERS number
}

Table report."054_segment_summary" [kind: 'report'] {
  SEGMENT unknown
  CUSTOMER_COUNT number
  NET_AMOUNT number
}

Table report."055_key_customers" [kind: 'report'] {
  CUSTOMER_ID unknown
  CUSTOMER_NAME unknown
  NET_AMOUNT_12M unknown
}

Table report."demo/unaliased_columns#2" [kind: 'report', note: 'note: invented: unaliased and repeated output names'] {
  ORDER_ID unknown
  "ORDER_ID (2)" unknown
  "COUNT(*)" number
  "NVL(O.SALES_REP_ID,-1)" number
}

// DBML raises on a column that depends on itself, so each self-dependency is a column property.
Metadata Column INV.STOCK_LEVELS.QTY_ON_HAND {
  note: 'self-dependency: TRANSFORMATION 1'
}
Metadata Column MART.CUSTOMER_SEGMENTS.SEGMENT {
  note: 'self-dependency: TRANSFORMATION 1'
}

// INV.STOCK_LEVELS
Dep: INV.SHIPMENTS -> INV.STOCK_LEVELS [note: 'queries 1']
Dep: INV.SHIPMENT_LINES -> INV.STOCK_LEVELS [note: 'queries 1']
Dep: INV.STOCK_LEVELS -> INV.STOCK_LEVELS [note: 'queries 1']
Dep: SALES.ORDER_LINES -> INV.STOCK_LEVELS [note: 'queries 1']
Dep: INV.SHIPMENTS.SHIPMENT_ID -> INV.STOCK_LEVELS [note: 'FILTER 1']
Dep: INV.SHIPMENTS.WAREHOUSE_ID -> INV.STOCK_LEVELS [note: 'FILTER 1']
Dep: INV.STOCK_LEVELS.WAREHOUSE_ID -> INV.STOCK_LEVELS [note: 'FILTER 1']
Dep: INV.SHIPMENT_LINES.LINE_NO -> INV.STOCK_LEVELS.QTY_ON_HAND [note: 'JOIN 1']
Dep: INV.SHIPMENT_LINES.ORDER_ID -> INV.STOCK_LEVELS.QTY_ON_HAND [note: 'JOIN 1']
Dep: INV.SHIPMENT_LINES.QTY_SHIPPED -> INV.STOCK_LEVELS.QTY_ON_HAND [note: 'AGGREGATION 1']
Dep: INV.SHIPMENT_LINES.SHIPMENT_ID -> INV.STOCK_LEVELS.QTY_ON_HAND [note: 'FILTER 1']
Dep: INV.STOCK_LEVELS.PRODUCT_ID -> INV.STOCK_LEVELS.QTY_ON_HAND [note: 'JOIN 1']
Dep: SALES.ORDER_LINES.LINE_NO -> INV.STOCK_LEVELS.QTY_ON_HAND [note: 'JOIN 1']
Dep: SALES.ORDER_LINES.ORDER_ID -> INV.STOCK_LEVELS.QTY_ON_HAND [note: 'JOIN 1']
Dep: SALES.ORDER_LINES.PRODUCT_ID -> INV.STOCK_LEVELS.QTY_ON_HAND [note: 'JOIN 1']

// MART.CUSTOMER_DAILY_SALES
Dep: MART.CUSTOMER_DAILY_SALES -> MART.CUSTOMER_DAILY_SALES [note: 'queries 1']
Dep: MART.ORDER_LINE_FACTS -> MART.CUSTOMER_DAILY_SALES [note: 'queries 2']
Dep: MART.CUSTOMER_DAILY_SALES.CURRENCY_CODE -> MART.CUSTOMER_DAILY_SALES [note: 'JOIN 1']
Dep: MART.CUSTOMER_DAILY_SALES.CUSTOMER_ID -> MART.CUSTOMER_DAILY_SALES [note: 'JOIN 1']
Dep: MART.CUSTOMER_DAILY_SALES.SALES_DATE -> MART.CUSTOMER_DAILY_SALES [note: 'JOIN 1']
Dep: MART.ORDER_LINE_FACTS.CURRENCY_CODE -> MART.CUSTOMER_DAILY_SALES [note: 'JOIN 1, GROUP_BY 2']
Dep: MART.ORDER_LINE_FACTS.CUSTOMER_ID -> MART.CUSTOMER_DAILY_SALES [note: 'JOIN 1, GROUP_BY 2']
Dep: MART.ORDER_LINE_FACTS.SALES_DATE -> MART.CUSTOMER_DAILY_SALES [note: 'JOIN 1, FILTER 1, GROUP_BY 2']
Dep: MART.ORDER_LINE_FACTS.CURRENCY_CODE -> MART.CUSTOMER_DAILY_SALES.CURRENCY_CODE [note: 'IDENTITY 2']
Dep: MART.ORDER_LINE_FACTS.CUSTOMER_ID -> MART.CUSTOMER_DAILY_SALES.CUSTOMER_ID [note: 'IDENTITY 2']
Dep: MART.ORDER_LINE_FACTS -> MART.CUSTOMER_DAILY_SALES.LINE_COUNT [note: 'AGGREGATION 2']
Dep: MART.ORDER_LINE_FACTS.NET_AMOUNT -> MART.CUSTOMER_DAILY_SALES.NET_AMOUNT [note: 'AGGREGATION 2']
Dep: MART.ORDER_LINE_FACTS.SALES_DATE -> MART.CUSTOMER_DAILY_SALES.SALES_DATE [note: 'IDENTITY 2']
Dep: MART.ORDER_LINE_FACTS.UNITS -> MART.CUSTOMER_DAILY_SALES.UNITS [note: 'AGGREGATION 2']

// MART.CUSTOMER_SEGMENTS
Dep: MART.CUSTOMER_DAILY_SALES -> MART.CUSTOMER_SEGMENTS [note: 'queries 1']
Dep: MART.CUSTOMER_SEGMENTS -> MART.CUSTOMER_SEGMENTS [note: 'queries 1']
Dep: SALES.CUSTOMERS -> MART.CUSTOMER_SEGMENTS [note: 'queries 1']
Dep: MART.CUSTOMER_DAILY_SALES.CUSTOMER_ID -> MART.CUSTOMER_SEGMENTS [note: 'JOIN 1, GROUP_BY 1']
Dep: MART.CUSTOMER_DAILY_SALES.SALES_DATE -> MART.CUSTOMER_SEGMENTS [note: 'FILTER 1']
Dep: MART.CUSTOMER_SEGMENTS.SEGMENT -> MART.CUSTOMER_SEGMENTS [note: 'FILTER 1']
Dep: SALES.CUSTOMERS.CUSTOMER_ID -> MART.CUSTOMER_SEGMENTS [note: 'JOIN 1']
Dep: SALES.CUSTOMERS.CUSTOMER_ID -> MART.CUSTOMER_SEGMENTS.CUSTOMER_ID [note: 'IDENTITY 1']
Dep: SALES.CUSTOMERS.CUSTOMER_NAME -> MART.CUSTOMER_SEGMENTS.CUSTOMER_NAME [note: 'IDENTITY 1']
Dep: MART.CUSTOMER_DAILY_SALES.NET_AMOUNT -> MART.CUSTOMER_SEGMENTS.NET_AMOUNT_12M [note: 'AGGREGATION 1']
Dep: MART.CUSTOMER_DAILY_SALES.NET_AMOUNT -> MART.CUSTOMER_SEGMENTS.SEGMENT [note: 'CONDITIONAL 1']
Dep: MART.CUSTOMER_DAILY_SALES.SALES_DATE -> MART.CUSTOMER_SEGMENTS.SEGMENT [note: 'CONDITIONAL 1']
Dep: MART.CUSTOMER_SEGMENTS.NET_AMOUNT_12M -> MART.CUSTOMER_SEGMENTS.SEGMENT [note: 'CONDITIONAL 1']

// MART.ORDER_LINE_FACTS
Dep: INV.PRODUCTS -> MART.ORDER_LINE_FACTS [note: 'queries 2']
Dep: SALES.ORDERS -> MART.ORDER_LINE_FACTS [note: 'queries 2']
Dep: SALES.ORDER_LINES -> MART.ORDER_LINE_FACTS [note: 'queries 2']
Dep: INV.PRODUCTS.PRODUCT_ID -> MART.ORDER_LINE_FACTS [note: 'JOIN 2']
Dep: SALES.ORDERS.ORDER_DATE -> MART.ORDER_LINE_FACTS [note: 'FILTER 1']
Dep: SALES.ORDERS.ORDER_ID -> MART.ORDER_LINE_FACTS [note: 'JOIN 2']
Dep: SALES.ORDERS.STATUS -> MART.ORDER_LINE_FACTS [note: 'FILTER 2']
Dep: SALES.ORDER_LINES.ORDER_ID -> MART.ORDER_LINE_FACTS [note: 'JOIN 2']
Dep: SALES.ORDER_LINES.PRODUCT_ID -> MART.ORDER_LINE_FACTS [note: 'JOIN 2']
Dep: INV.PRODUCTS.CATEGORY_ID -> MART.ORDER_LINE_FACTS.CATEGORY_ID [note: 'IDENTITY 2']
Dep: SALES.ORDERS.CURRENCY_CODE -> MART.ORDER_LINE_FACTS.CURRENCY_CODE [note: 'IDENTITY 2']
Dep: SALES.ORDERS.CUSTOMER_ID -> MART.ORDER_LINE_FACTS.CUSTOMER_ID [note: 'IDENTITY 2']
Dep: SALES.ORDER_LINES.LINE_NO -> MART.ORDER_LINE_FACTS.LINE_NO [note: 'IDENTITY 2']
Dep: SALES.ORDER_LINES.DISCOUNT_PCT -> MART.ORDER_LINE_FACTS.NET_AMOUNT [note: 'TRANSFORMATION 2']
Dep: SALES.ORDER_LINES.QUANTITY -> MART.ORDER_LINE_FACTS.NET_AMOUNT [note: 'TRANSFORMATION 2']
Dep: SALES.ORDER_LINES.UNIT_PRICE -> MART.ORDER_LINE_FACTS.NET_AMOUNT [note: 'TRANSFORMATION 2']
Dep: SALES.ORDERS.ORDER_ID -> MART.ORDER_LINE_FACTS.ORDER_ID [note: 'IDENTITY 2']
Dep: SALES.ORDER_LINES.PRODUCT_ID -> MART.ORDER_LINE_FACTS.PRODUCT_ID [note: 'IDENTITY 2']
Dep: SALES.ORDERS.ORDER_DATE -> MART.ORDER_LINE_FACTS.SALES_DATE [note: 'TRANSFORMATION 2']
Dep: SALES.ORDER_LINES.QUANTITY -> MART.ORDER_LINE_FACTS.UNITS [note: 'IDENTITY 2']

// MART.V_KEY_CUSTOMERS
Dep: MART.CUSTOMER_SEGMENTS -> MART.V_KEY_CUSTOMERS [note: 'queries 1']
Dep: MART.CUSTOMER_SEGMENTS.SEGMENT -> MART.V_KEY_CUSTOMERS [note: 'FILTER 1']
Dep: MART.CUSTOMER_SEGMENTS.CUSTOMER_ID -> MART.V_KEY_CUSTOMERS.CUSTOMER_ID [note: 'IDENTITY 1']
Dep: MART.CUSTOMER_SEGMENTS.CUSTOMER_NAME -> MART.V_KEY_CUSTOMERS.CUSTOMER_NAME [note: 'IDENTITY 1']
Dep: MART.CUSTOMER_SEGMENTS.NET_AMOUNT_12M -> MART.V_KEY_CUSTOMERS.NET_AMOUNT_12M [note: 'IDENTITY 1']
Dep: MART.CUSTOMER_SEGMENTS.SEGMENT -> MART.V_KEY_CUSTOMERS.SEGMENT [note: 'IDENTITY 1']

// report.016_unqualified_columns_in_join
Dep: SALES.CUSTOMERS -> report."016_unqualified_columns_in_join" [note: 'queries 1']
Dep: SALES.ORDERS -> report."016_unqualified_columns_in_join" [note: 'queries 1']
Dep: SALES.CUSTOMERS.CUSTOMER_ID -> report."016_unqualified_columns_in_join" [note: 'JOIN 1']
Dep: SALES.ORDERS.CUSTOMER_ID -> report."016_unqualified_columns_in_join" [note: 'JOIN 1']

// report.038_daily_reports#1
Dep: SALES.ORDERS -> report."038_daily_reports#1" [note: 'queries 1']
Dep: SALES.ORDERS.ORDER_DATE -> report."038_daily_reports#1" [note: 'FILTER 1']
Dep: SALES.ORDERS -> report."038_daily_reports#1".NEW_ORDERS [note: 'AGGREGATION 1']

// report.038_daily_reports#2
Dep: SALES.CUSTOMERS -> report."038_daily_reports#2" [note: 'queries 1']
Dep: SALES.CUSTOMERS.CREATED_AT -> report."038_daily_reports#2" [note: 'FILTER 1']
Dep: SALES.CUSTOMERS -> report."038_daily_reports#2".NEW_CUSTOMERS [note: 'AGGREGATION 1']

// report.054_segment_summary
Dep: MART.CUSTOMER_SEGMENTS -> report."054_segment_summary" [note: 'queries 1']
Dep: MART.CUSTOMER_SEGMENTS.NET_AMOUNT_12M -> report."054_segment_summary" [note: 'SORT 1']
Dep: MART.CUSTOMER_SEGMENTS.SEGMENT -> report."054_segment_summary" [note: 'GROUP_BY 1']
Dep: MART.CUSTOMER_SEGMENTS -> report."054_segment_summary".CUSTOMER_COUNT [note: 'AGGREGATION 1']
Dep: MART.CUSTOMER_SEGMENTS.NET_AMOUNT_12M -> report."054_segment_summary".NET_AMOUNT [note: 'AGGREGATION 1']
Dep: MART.CUSTOMER_SEGMENTS.SEGMENT -> report."054_segment_summary".SEGMENT [note: 'IDENTITY 1']

// report.055_key_customers
Dep: MART.V_KEY_CUSTOMERS -> report."055_key_customers" [note: 'queries 1']
Dep: MART.V_KEY_CUSTOMERS.NET_AMOUNT_12M -> report."055_key_customers" [note: 'SORT 1']
Dep: MART.V_KEY_CUSTOMERS.CUSTOMER_ID -> report."055_key_customers".CUSTOMER_ID [note: 'IDENTITY 1']
Dep: MART.V_KEY_CUSTOMERS.CUSTOMER_NAME -> report."055_key_customers".CUSTOMER_NAME [note: 'IDENTITY 1']
Dep: MART.V_KEY_CUSTOMERS.NET_AMOUNT_12M -> report."055_key_customers".NET_AMOUNT_12M [note: 'IDENTITY 1']

// report.demo/unaliased_columns#2
Dep: SALES.ORDERS -> report."demo/unaliased_columns#2" [note: 'queries 1']
Dep: SALES.ORDER_LINES -> report."demo/unaliased_columns#2" [note: 'queries 1']
Dep: SALES.ORDERS.ORDER_ID -> report."demo/unaliased_columns#2" [note: 'JOIN 1']
Dep: SALES.ORDER_LINES.ORDER_ID -> report."demo/unaliased_columns#2" [note: 'JOIN 1']
Dep: SALES.ORDER_LINES -> report."demo/unaliased_columns#2"."COUNT(*)" [note: 'AGGREGATION 1']
Dep: SALES.ORDERS.SALES_REP_ID -> report."demo/unaliased_columns#2"."NVL(O.SALES_REP_ID,-1)" [note: 'TRANSFORMATION 1']
Dep: SALES.ORDERS.ORDER_ID -> report."demo/unaliased_columns#2".ORDER_ID [note: 'IDENTITY 1']
Dep: SALES.ORDER_LINES.ORDER_ID -> report."demo/unaliased_columns#2"."ORDER_ID (2)" [note: 'IDENTITY 1']
