use * from './schema.dbml'

Table report."016_unqualified_columns_in_join" [kind: 'report', ambiguity: 'filter on ORDER_TOTAL and CREDIT_LIMIT: SALES.ORDERS or SALES.CUSTOMERS'] {
  ORDER_ID unknown [ambiguity: 'upstream SALES.ORDERS.ORDER_ID (14) or SALES.CUSTOMERS.ORDER_ID (0)']
  ORDER_DATE unknown [ambiguity: 'upstream SALES.ORDERS.ORDER_DATE (9) or SALES.CUSTOMERS.ORDER_DATE (0)']
  CUSTOMER_NAME unknown [ambiguity: 'upstream SALES.ORDERS.CUSTOMER_NAME (0) or SALES.CUSTOMERS.CUSTOMER_NAME (9)']
  CREDIT_LIMIT unknown [ambiguity: 'upstream SALES.ORDERS.CREDIT_LIMIT (0) or SALES.CUSTOMERS.CREDIT_LIMIT (0)']
}

Table report."038_daily_reports#1" [kind: 'report'] {
  NEW_ORDERS number
}

Table report."038_daily_reports#2" [kind: 'report'] {
  NEW_CUSTOMERS number
}

Table report."054_segment_summary" [kind: 'report'] {
  SEGMENT unknown
  CUSTOMER_COUNT number
  NET_AMOUNT number
}

Table report."055_key_customers" [kind: 'report'] {
  CUSTOMER_ID unknown
  CUSTOMER_NAME unknown
  NET_AMOUNT_12M unknown
}

Table report."demo/unaliased_columns#2" [kind: 'report', note: 'invented: unaliased and repeated output names'] {
  ORDER_ID unknown
  "ORDER_ID (2)" unknown
  "COUNT(*)" number
  "NVL(O.SALES_REP_ID,-1)" number
}

// DBML raises on a column that depends on itself, so each self-dependency is a column property.
Metadata Column INV.STOCK_LEVELS.QTY_ON_HAND {
  self_dependency: 'TRANSFORMATION 1'
}
Metadata Column MART.CUSTOMER_SEGMENTS.SEGMENT {
  self_dependency: 'TRANSFORMATION 1'
}

// INV.STOCK_LEVELS
Dep: INV.SHIPMENTS -> INV.STOCK_LEVELS [queries: 1]
Dep: INV.SHIPMENT_LINES -> INV.STOCK_LEVELS [queries: 1]
Dep: INV.STOCK_LEVELS -> INV.STOCK_LEVELS [queries: 1]
Dep: SALES.ORDER_LINES -> INV.STOCK_LEVELS [queries: 1]
Dep: INV.SHIPMENTS.SHIPMENT_ID -> INV.STOCK_LEVELS [filter: 1]
Dep: INV.SHIPMENTS.WAREHOUSE_ID -> INV.STOCK_LEVELS [filter: 1]
Dep: INV.STOCK_LEVELS.WAREHOUSE_ID -> INV.STOCK_LEVELS [filter: 1]
Dep: INV.SHIPMENT_LINES.LINE_NO -> INV.STOCK_LEVELS.QTY_ON_HAND [join: 1]
Dep: INV.SHIPMENT_LINES.ORDER_ID -> INV.STOCK_LEVELS.QTY_ON_HAND [join: 1]
Dep: INV.SHIPMENT_LINES.QTY_SHIPPED -> INV.STOCK_LEVELS.QTY_ON_HAND [aggregation: 1]
Dep: INV.SHIPMENT_LINES.SHIPMENT_ID -> INV.STOCK_LEVELS.QTY_ON_HAND [filter: 1]
Dep: INV.STOCK_LEVELS.PRODUCT_ID -> INV.STOCK_LEVELS.QTY_ON_HAND [join: 1]
Dep: SALES.ORDER_LINES.LINE_NO -> INV.STOCK_LEVELS.QTY_ON_HAND [join: 1]
Dep: SALES.ORDER_LINES.ORDER_ID -> INV.STOCK_LEVELS.QTY_ON_HAND [join: 1]
Dep: SALES.ORDER_LINES.PRODUCT_ID -> INV.STOCK_LEVELS.QTY_ON_HAND [join: 1]

// MART.CUSTOMER_DAILY_SALES
Dep: MART.CUSTOMER_DAILY_SALES -> MART.CUSTOMER_DAILY_SALES [queries: 1]
Dep: MART.ORDER_LINE_FACTS -> MART.CUSTOMER_DAILY_SALES [queries: 2]
Dep: MART.CUSTOMER_DAILY_SALES.CURRENCY_CODE -> MART.CUSTOMER_DAILY_SALES [join: 1]
Dep: MART.CUSTOMER_DAILY_SALES.CUSTOMER_ID -> MART.CUSTOMER_DAILY_SALES [join: 1]
Dep: MART.CUSTOMER_DAILY_SALES.SALES_DATE -> MART.CUSTOMER_DAILY_SALES [join: 1]
Dep: MART.ORDER_LINE_FACTS.CURRENCY_CODE -> MART.CUSTOMER_DAILY_SALES [join: 1, group_by: 2]
Dep: MART.ORDER_LINE_FACTS.CUSTOMER_ID -> MART.CUSTOMER_DAILY_SALES [join: 1, group_by: 2]
Dep: MART.ORDER_LINE_FACTS.SALES_DATE -> MART.CUSTOMER_DAILY_SALES [join: 1, filter: 1, group_by: 2]
Dep: MART.ORDER_LINE_FACTS.CURRENCY_CODE -> MART.CUSTOMER_DAILY_SALES.CURRENCY_CODE [identity: 2]
Dep: MART.ORDER_LINE_FACTS.CUSTOMER_ID -> MART.CUSTOMER_DAILY_SALES.CUSTOMER_ID [identity: 2]
Dep: MART.ORDER_LINE_FACTS -> MART.CUSTOMER_DAILY_SALES.LINE_COUNT [aggregation: 2]
Dep: MART.ORDER_LINE_FACTS.NET_AMOUNT -> MART.CUSTOMER_DAILY_SALES.NET_AMOUNT [aggregation: 2]
Dep: MART.ORDER_LINE_FACTS.SALES_DATE -> MART.CUSTOMER_DAILY_SALES.SALES_DATE [identity: 2]
Dep: MART.ORDER_LINE_FACTS.UNITS -> MART.CUSTOMER_DAILY_SALES.UNITS [aggregation: 2]

// MART.CUSTOMER_SEGMENTS
Dep: MART.CUSTOMER_DAILY_SALES -> MART.CUSTOMER_SEGMENTS [queries: 1]
Dep: MART.CUSTOMER_SEGMENTS -> MART.CUSTOMER_SEGMENTS [queries: 1]
Dep: SALES.CUSTOMERS -> MART.CUSTOMER_SEGMENTS [queries: 1]
Dep: MART.CUSTOMER_DAILY_SALES.CUSTOMER_ID -> MART.CUSTOMER_SEGMENTS [join: 1, group_by: 1]
Dep: MART.CUSTOMER_DAILY_SALES.SALES_DATE -> MART.CUSTOMER_SEGMENTS [filter: 1]
Dep: MART.CUSTOMER_SEGMENTS.SEGMENT -> MART.CUSTOMER_SEGMENTS [filter: 1]
Dep: SALES.CUSTOMERS.CUSTOMER_ID -> MART.CUSTOMER_SEGMENTS [join: 1]
Dep: SALES.CUSTOMERS.CUSTOMER_ID -> MART.CUSTOMER_SEGMENTS.CUSTOMER_ID [identity: 1]
Dep: SALES.CUSTOMERS.CUSTOMER_NAME -> MART.CUSTOMER_SEGMENTS.CUSTOMER_NAME [identity: 1]
Dep: MART.CUSTOMER_DAILY_SALES.NET_AMOUNT -> MART.CUSTOMER_SEGMENTS.NET_AMOUNT_12M [aggregation: 1]
Dep: MART.CUSTOMER_DAILY_SALES.NET_AMOUNT -> MART.CUSTOMER_SEGMENTS.SEGMENT [conditional: 1]
Dep: MART.CUSTOMER_DAILY_SALES.SALES_DATE -> MART.CUSTOMER_SEGMENTS.SEGMENT [conditional: 1]
Dep: MART.CUSTOMER_SEGMENTS.NET_AMOUNT_12M -> MART.CUSTOMER_SEGMENTS.SEGMENT [conditional: 1]

// MART.ORDER_LINE_FACTS
Dep: INV.PRODUCTS -> MART.ORDER_LINE_FACTS [queries: 2]
Dep: SALES.ORDERS -> MART.ORDER_LINE_FACTS [queries: 2]
Dep: SALES.ORDER_LINES -> MART.ORDER_LINE_FACTS [queries: 2]
Dep: INV.PRODUCTS.PRODUCT_ID -> MART.ORDER_LINE_FACTS [join: 2]
Dep: SALES.ORDERS.ORDER_DATE -> MART.ORDER_LINE_FACTS [filter: 1]
Dep: SALES.ORDERS.ORDER_ID -> MART.ORDER_LINE_FACTS [join: 2]
Dep: SALES.ORDERS.STATUS -> MART.ORDER_LINE_FACTS [filter: 2]
Dep: SALES.ORDER_LINES.ORDER_ID -> MART.ORDER_LINE_FACTS [join: 2]
Dep: SALES.ORDER_LINES.PRODUCT_ID -> MART.ORDER_LINE_FACTS [join: 2]
Dep: INV.PRODUCTS.CATEGORY_ID -> MART.ORDER_LINE_FACTS.CATEGORY_ID [identity: 2]
Dep: SALES.ORDERS.CURRENCY_CODE -> MART.ORDER_LINE_FACTS.CURRENCY_CODE [identity: 2]
Dep: SALES.ORDERS.CUSTOMER_ID -> MART.ORDER_LINE_FACTS.CUSTOMER_ID [identity: 2]
Dep: SALES.ORDER_LINES.LINE_NO -> MART.ORDER_LINE_FACTS.LINE_NO [identity: 2]
Dep: SALES.ORDER_LINES.DISCOUNT_PCT -> MART.ORDER_LINE_FACTS.NET_AMOUNT [transformation: 2]
Dep: SALES.ORDER_LINES.QUANTITY -> MART.ORDER_LINE_FACTS.NET_AMOUNT [transformation: 2]
Dep: SALES.ORDER_LINES.UNIT_PRICE -> MART.ORDER_LINE_FACTS.NET_AMOUNT [transformation: 2]
Dep: SALES.ORDERS.ORDER_ID -> MART.ORDER_LINE_FACTS.ORDER_ID [identity: 2]
Dep: SALES.ORDER_LINES.PRODUCT_ID -> MART.ORDER_LINE_FACTS.PRODUCT_ID [identity: 2]
Dep: SALES.ORDERS.ORDER_DATE -> MART.ORDER_LINE_FACTS.SALES_DATE [transformation: 2]
Dep: SALES.ORDER_LINES.QUANTITY -> MART.ORDER_LINE_FACTS.UNITS [identity: 2]

// MART.V_KEY_CUSTOMERS
Dep: MART.CUSTOMER_SEGMENTS -> MART.V_KEY_CUSTOMERS [queries: 1]
Dep: MART.CUSTOMER_SEGMENTS.SEGMENT -> MART.V_KEY_CUSTOMERS [filter: 1]
Dep: MART.CUSTOMER_SEGMENTS.CUSTOMER_ID -> MART.V_KEY_CUSTOMERS.CUSTOMER_ID [identity: 1]
Dep: MART.CUSTOMER_SEGMENTS.CUSTOMER_NAME -> MART.V_KEY_CUSTOMERS.CUSTOMER_NAME [identity: 1]
Dep: MART.CUSTOMER_SEGMENTS.NET_AMOUNT_12M -> MART.V_KEY_CUSTOMERS.NET_AMOUNT_12M [identity: 1]
Dep: MART.CUSTOMER_SEGMENTS.SEGMENT -> MART.V_KEY_CUSTOMERS.SEGMENT [identity: 1]

// report.016_unqualified_columns_in_join
Dep: SALES.CUSTOMERS -> report."016_unqualified_columns_in_join" [queries: 1]
Dep: SALES.ORDERS -> report."016_unqualified_columns_in_join" [queries: 1]
Dep: SALES.CUSTOMERS.CUSTOMER_ID -> report."016_unqualified_columns_in_join" [join: 1]
Dep: SALES.ORDERS.CUSTOMER_ID -> report."016_unqualified_columns_in_join" [join: 1]

// report.038_daily_reports#1
Dep: SALES.ORDERS -> report."038_daily_reports#1" [queries: 1]
Dep: SALES.ORDERS.ORDER_DATE -> report."038_daily_reports#1" [filter: 1]
Dep: SALES.ORDERS -> report."038_daily_reports#1".NEW_ORDERS [aggregation: 1]

// report.038_daily_reports#2
Dep: SALES.CUSTOMERS -> report."038_daily_reports#2" [queries: 1]
Dep: SALES.CUSTOMERS.CREATED_AT -> report."038_daily_reports#2" [filter: 1]
Dep: SALES.CUSTOMERS -> report."038_daily_reports#2".NEW_CUSTOMERS [aggregation: 1]

// report.054_segment_summary
Dep: MART.CUSTOMER_SEGMENTS -> report."054_segment_summary" [queries: 1]
Dep: MART.CUSTOMER_SEGMENTS.NET_AMOUNT_12M -> report."054_segment_summary" [sort: 1]
Dep: MART.CUSTOMER_SEGMENTS.SEGMENT -> report."054_segment_summary" [group_by: 1]
Dep: MART.CUSTOMER_SEGMENTS -> report."054_segment_summary".CUSTOMER_COUNT [aggregation: 1]
Dep: MART.CUSTOMER_SEGMENTS.NET_AMOUNT_12M -> report."054_segment_summary".NET_AMOUNT [aggregation: 1]
Dep: MART.CUSTOMER_SEGMENTS.SEGMENT -> report."054_segment_summary".SEGMENT [identity: 1]

// report.055_key_customers
Dep: MART.V_KEY_CUSTOMERS -> report."055_key_customers" [queries: 1]
Dep: MART.V_KEY_CUSTOMERS.NET_AMOUNT_12M -> report."055_key_customers" [sort: 1]
Dep: MART.V_KEY_CUSTOMERS.CUSTOMER_ID -> report."055_key_customers".CUSTOMER_ID [identity: 1]
Dep: MART.V_KEY_CUSTOMERS.CUSTOMER_NAME -> report."055_key_customers".CUSTOMER_NAME [identity: 1]
Dep: MART.V_KEY_CUSTOMERS.NET_AMOUNT_12M -> report."055_key_customers".NET_AMOUNT_12M [identity: 1]

// report.demo/unaliased_columns#2
Dep: SALES.ORDERS -> report."demo/unaliased_columns#2" [queries: 1]
Dep: SALES.ORDER_LINES -> report."demo/unaliased_columns#2" [queries: 1]
Dep: SALES.ORDERS.ORDER_ID -> report."demo/unaliased_columns#2" [join: 1]
Dep: SALES.ORDER_LINES.ORDER_ID -> report."demo/unaliased_columns#2" [join: 1]
Dep: SALES.ORDER_LINES -> report."demo/unaliased_columns#2"."COUNT(*)" [aggregation: 1]
Dep: SALES.ORDERS.SALES_REP_ID -> report."demo/unaliased_columns#2"."NVL(O.SALES_REP_ID,-1)" [transformation: 1]
Dep: SALES.ORDERS.ORDER_ID -> report."demo/unaliased_columns#2".ORDER_ID [identity: 1]
Dep: SALES.ORDER_LINES.ORDER_ID -> report."demo/unaliased_columns#2"."ORDER_ID (2)" [identity: 1]
