Project ichnos {
  database_type: 'Oracle'
  Note: '''
  Upstream of report."054_segment_summary", with indirect dependencies on the first hop: 5 of 32 tables.
  Inferred from 60 queries, with no database connection.
  A column with no type evidence has the type `unknown`.
  `null` claims a column can hold NULL. ichnos never claims NOT NULL.
  `complete: true` means the declarations list every column.
  A table with no `kind` may list only some of its columns.
  The schema `report` holds the reports, which are queries, not tables.
  '''
}

Table MART.CUSTOMER_SEGMENTS [kind: 'base table', complete: true, declared: 1, read: 3, write: 1] {
  NET_AMOUNT_12M number [declared: 1]
  SEGMENT text [declared: 1, observed: 'KEY, STRATEGIC']
}

Table MART.CUSTOMER_DAILY_SALES [kind: 'base table', complete: true, declared: 1, read: 4, write: 1, keys: '(CUSTOMER_ID, SALES_DATE, CURRENCY_CODE): merge 1, grouped 1'] {
  NET_AMOUNT number [declared: 1]
}

Table MART.ORDER_LINE_FACTS [kind: 'base table', complete: true, declared: 1, read: 3, write: 1] {
  NET_AMOUNT number [declared: 1]
}

Table SALES.ORDER_LINES [read: 9, write: 1] {
  DISCOUNT_PCT number [null, nullable: 3]
  QUANTITY number
  UNIT_PRICE number
}

Table INV.PRODUCTS [read: 7, keys: 'PRODUCT_ID: name match <S>_ID'] {
  LIST_PRICE unknown
}

Table report."054_segment_summary" [kind: 'report'] {
  SEGMENT unknown
  CUSTOMER_COUNT number
  NET_AMOUNT number
}

Metadata Column MART.CUSTOMER_SEGMENTS.SEGMENT {
  self_dependency: 'TRANSFORMATION 1'
}

Metadata Column SALES.ORDER_LINES.QUANTITY {
  self_dependency: 'IDENTITY 1'
}

Dep: MART.ORDER_LINE_FACTS.NET_AMOUNT -> MART.CUSTOMER_DAILY_SALES.NET_AMOUNT [aggregation: 2]
Dep: MART.CUSTOMER_DAILY_SALES.NET_AMOUNT -> MART.CUSTOMER_SEGMENTS.NET_AMOUNT_12M [aggregation: 1]
Dep: SALES.ORDER_LINES.DISCOUNT_PCT -> MART.ORDER_LINE_FACTS.NET_AMOUNT [transformation: 2]
Dep: SALES.ORDER_LINES.QUANTITY -> MART.ORDER_LINE_FACTS.NET_AMOUNT [transformation: 2]
Dep: SALES.ORDER_LINES.UNIT_PRICE -> MART.ORDER_LINE_FACTS.NET_AMOUNT [transformation: 2]
Dep: INV.PRODUCTS.LIST_PRICE -> SALES.ORDER_LINES.UNIT_PRICE [identity: 1]
Dep: MART.CUSTOMER_SEGMENTS.NET_AMOUNT_12M -> report."054_segment_summary" [sort: 1]
Dep: MART.CUSTOMER_SEGMENTS.SEGMENT -> report."054_segment_summary" [group_by: 1]
Dep: MART.CUSTOMER_SEGMENTS -> report."054_segment_summary".CUSTOMER_COUNT [aggregation: 1]
Dep: MART.CUSTOMER_SEGMENTS.NET_AMOUNT_12M -> report."054_segment_summary".NET_AMOUNT [aggregation: 1]
Dep: MART.CUSTOMER_SEGMENTS.SEGMENT -> report."054_segment_summary".SEGMENT [identity: 1]

