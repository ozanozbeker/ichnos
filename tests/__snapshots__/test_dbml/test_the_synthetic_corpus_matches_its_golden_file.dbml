}

Ref "join 1": EMP.DEPARTMENT_ID >? HR.DEPARTMENTS.DEPARTMENT_ID
Ref "join 1": ORDERS.CUSTOMER_ID >? CUSTOMERS.CUSTOMER_ID
Ref "join 1": ORDER_LINES.PRODUCT_ID >? PRODUCTS.PRODUCT_ID
Ref "join 1": HR.DEPARTMENTS.LOCATION_COUNTRY >? REF.COUNTRIES.COUNTRY_CODE
Ref "join 1": HR.DEPARTMENTS.MANAGER_ID >? HR.EMPLOYEES.EMPLOYEE_ID
Ref "join 1": HR.EMPLOYEES.MANAGER_ID >? HR.EMPLOYEES.EMPLOYEE_ID
Ref "join 1": HR.EMP_DIRECTORY.DEPT_NO >? HR.DEPARTMENTS.DEPARTMENT_ID
Ref "join 1": INV.PRODUCT_CATEGORIES.PARENT_CATEGORY_ID >? INV.PRODUCT_CATEGORIES.CATEGORY_ID
Ref "join 1": INV.SHIPMENTS.WAREHOUSE_ID >? INV.WAREHOUSES.ID
Ref "join 2": INV.SHIPMENT_LINES.(LINE_NO, ORDER_ID) ?<>? SALES.ORDER_LINES.(LINE_NO, ORDER_ID)
Ref "join 1": INV.STOCK_LEVELS.PRODUCT_ID ?<>? SALES.ORDER_LINES.PRODUCT_ID
Ref "join 1": INV.STOCK_LEVELS.WAREHOUSE_ID >? INV.WAREHOUSES.ID
Ref "join 1": INV.WAREHOUSES.COUNTRY_CODE >? REF.COUNTRIES.COUNTRY_CODE
Ref "join 1": MART.LAPSED_CUSTOMERS.CUSTOMER_ID ?-? SALES.CUSTOMERS.CUSTOMER_ID
Ref "join 1": MART.ORDER_LINE_FACTS.CATEGORY_ID >? INV.PRODUCT_CATEGORIES.CATEGORY_ID
Ref "join 1": SALES.CUSTOMERS.ACCOUNT_MANAGER_ID >? HR.EMPLOYEES.EMPLOYEE_ID
Ref "join 1": SALES.CUSTOMER_ADDRESSES.COUNTRY_CODE >? REF.COUNTRIES.COUNTRY_CODE
Ref "join 1": SALES.ORDERS.BILL_TO_ADDRESS_ID >? SALES.CUSTOMER_ADDRESSES.ADDRESS_ID
Ref "join 1": SALES.ORDERS.(CURRENCY_CODE, ORDER_ID) ?<>? SALES.PAYMENTS.(CURRENCY_CODE, ORDER_ID)
Ref "join 4": SALES.ORDERS.CUSTOMER_ID >? SALES.CUSTOMERS.CUSTOMER_ID
Ref "join 1": SALES.ORDERS.SHIP_TO_ADDRESS_ID >? SALES.CUSTOMER_ADDRESSES.ADDRESS_ID
Ref "join 3": SALES.ORDER_LINES.ORDER_ID >? SALES.ORDERS.ORDER_ID
Ref "join 4": SALES.ORDER_LINES.PRODUCT_ID >? INV.PRODUCTS.PRODUCT_ID
Ref "join 1": SALES.ORDER_PROMOTIONS.ORDER_ID >? SALES.ORDERS.ORDER_ID
Ref "join 2": SALES.ORDER_PROMOTIONS.PROMO_ID ?<>? SALES.PROMOTIONS.PROMO_ID
Ref "join 2": SALES.PAYMENTS.ORDER_ID >? SALES.ORDERS.ORDER_ID

